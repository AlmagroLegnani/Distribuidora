{
  "name": "@stockapp/api",
  "version": "0.0.1",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node -r dotenv/config dist/index.js",
    "test": "jest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "@stockapp/shared": "*",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "commander": "^4.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fraction.js": "^5.3.4",
    "helmet": "^7.1.0",
    "https-proxy-agent": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.2.0",
    "merge2": "^1.4.1",
    "mz": "^2.7.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^9.0.3",
    "scheduler": "^0.23.2",
    "scmp": "^2.1.0",
    "ts-interface-checker": "^0.1.13",
    "twilio": "^4.23.0",
    "url-parse": "^1.5.10",
    "wordwrap": "^1.0.0",
    "xmlbuilder": "^13.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.2",
    "bs-logger": "^0.2.6",
    "jest": "^29.7.0",
    "lodash.memoize": "^4.1.2",
    "prisma": "^5.8.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "schema": "../db/prisma/schema.prisma"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {}
      ]
    }
  }
}
