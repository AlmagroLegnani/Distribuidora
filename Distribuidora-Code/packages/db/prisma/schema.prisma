generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Distribuidor (tenant)
model Distributor {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // hash bcrypt
  phone     String?
  rut       String?  @unique // RUT de la distribuidora, si tiene
  cedula    String?  @unique // Cédula de identidad, para distribuidoras unipersonales sin RUT
  address   String? // dirección del local/depósito, texto libre
  city      String? // departamento de Uruguay (lista fija, ver lib/uruguayDepartments.ts) — usado para filtrar distribuidoras por zona en /distribuidoras
  // false hasta que la distribuidora elige su propia contraseña (al crearla,
  // "password" es en realidad el código de acceso que le mandamos por email).
  // Se usa para saber si mostrarle "Creá tu contraseña" o "Cambiar contraseña".
  passwordChanged Boolean @default(false)
  logoUrl   String?
  slug      String   @unique // identificador único de URL ej: "distrib-norte"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  clients      Client[]
  orders       Order[]
  settings     DistributorSettings?
  subscription Subscription?
  resetTokens  PasswordResetToken[]
  stockAlerts  StockAlert[]
  clientPrices ClientPrice[]
  impersonations ImpersonationLog[]
  pushSubscriptions PushSubscription[]
  stockWaitlist StockWaitlist[]
}

// Administrador de la plataforma (dueño del SaaS, no un distribuidor)
model PlatformAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // hash bcrypt
  name      String?
  createdAt DateTime @default(now())

  impersonations ImpersonationLog[]
}

// Auditoría de "Entrar como esta distribuidora": queda registrado qué cuenta
// de super admin entró al panel de qué distribuidora y cuándo, para que ese
// acceso de soporte quede prolijo y trazable (nunca se guarda ni se necesita
// ver la contraseña real de la distribuidora para esto).
model ImpersonationLog {
  id              String   @id @default(cuid())
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  distributorId   String
  distributor     Distributor   @relation(fields: [distributorId], references: [id])
  createdAt       DateTime      @default(now())
}

// Plan comercial ofrecido a las distribuidoras
model Plan {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  price          Float    // precio mensual
  currency       String   @default("UYU")
  maxProducts    Int?     // null = ilimitado
  maxClients     Int?
  maxOrdersMonth Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDING_PAYMENT // recién creada, esperando primer pago
  TRIALING
  ACTIVE
  PAST_DUE // venció el período pero está en gracia
  SUSPENDED // se cortó el acceso por falta de pago
  CANCELLED
}

// Suscripción de una distribuidora a un plan
model Subscription {
  id               String             @id @default(cuid())
  distributorId    String             @unique
  distributor      Distributor        @relation(fields: [distributorId], references: [id])
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(PENDING_PAYMENT)
  currentPeriodEnd DateTime?
  trialEndsAt      DateTime?
  mpPreferenceId   String? // id de la preferencia/checkout de MercadoPago vigente
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments Payment[]
}

// Pago registrado (MercadoPago o manual)
model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  mpPaymentId    String?      @unique
  amount         Float
  currency       String       @default("UYU")
  status         String       // approved | pending | rejected | manual
  method         String       @default("mercadopago") // mercadopago | manual
  paidAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
}

// Token de recuperación de contraseña para distribuidores
model PasswordResetToken {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  token         String      @unique
  expiresAt     DateTime
  used          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

// Configuración del distribuidor
model DistributorSettings {
  id                String      @id @default(cuid())
  distributorId     String      @unique
  distributor       Distributor @relation(fields: [distributorId], references: [id])
  notificationEmail String?
  whatsappNumber    String?
  sendClientEmail   Boolean     @default(true)
  sendWhatsapp      Boolean     @default(false)
}

// Producto
model Product {
  id              String      @id @default(cuid())
  distributorId   String
  distributor     Distributor @relation(fields: [distributorId], references: [id])
  name            String
  code            String?
  brand           String?
  description     String?
  price           Float
  // Tasa de IVA de Uruguay que ya está incluida en `price` (precio final al
  // público, no se recalcula nada) — BASICA 22% por defecto, MINIMA 10% para
  // productos de primera necesidad. Ver lib/iva.ts para los porcentajes.
  ivaType         IvaType     @default(BASICA)
  stock           Int
  category        String?
  imageUrl        String?
  active          Boolean     @default(true)
  // true mientras el stock sigue por debajo del umbral de aviso (ver stockAlertService.LOW_STOCK_THRESHOLD)
  // y ya se generó una alerta; se resetea a false cuando el stock vuelve a superar el umbral,
  // para poder avisar de nuevo si vuelve a caer más adelante.
  lowStockAlerted Boolean     @default(false)
  // Promoción "de fábrica" que el laboratorio/marca le da a la distribuidora
  // para este producto (ej: "Llevate de regalo un marcador Bic", "2x1 esta
  // semana") — texto libre, visible para TODOS los clientes de la
  // distribuidora en el catálogo. A diferencia de ClientPrice (descuento en $
  // para un cliente puntual), esto no toca el precio, es solo un aviso. Al
  // activarla (false -> true) se les manda una notificación push a los
  // clientes que la tengan habilitada — ver promotionNotificationService.ts.
  // promotionEndDate es opcional: si se completa, el catálogo público deja
  // de mostrar la promo pasada esa fecha sin que la distribuidora tenga que
  // acordarse de apagarla a mano (el flag promotionActive no se toca solo,
  // así conserva el texto por si la quiere reactivar más adelante).
  promotionActive  Boolean     @default(false)
  promotionText    String?
  promotionEndDate DateTime?   @db.Date
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems    OrderItem[]
  stockAlerts   StockAlert[]
  clientPrices  ClientPrice[]
  stockWaitlist StockWaitlist[]

  @@unique([distributorId, code])
}

// Notificación mostrada al distribuidor en su panel (sección "Notificaciones" +
// modal al ingresar). Nació como aviso de stock bajo (ver stockAlertService.ts)
// y se generalizó para poder avisar también vencimientos de pago (ver
// platformService.notifyPaymentDue) y sugerencias de recompra (ver
// reorderSuggestionService.ts) — de ahí que los campos de producto/cliente
// sean opcionales y sólo se completen según el tipo.
model StockAlert {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  type          String      @default("LOW_STOCK") // LOW_STOCK | PAYMENT_DUE | REORDER_SUGGESTION
  message       String? // texto ya armado para tipos que no son de stock (ej: aviso de vencimiento o sugerencia de recompra)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  productName   String? // copia del nombre al momento de la alerta, por si el producto cambia de nombre o se borra
  stockAtAlert  Int?
  threshold     Int?
  // Solo se completan cuando type = REORDER_SUGGESTION: el cliente que viene
  // pidiendo el producto seguido, para poder mandarle el recordatorio por push
  // cuando la distribuidora hace clic en "Enviar recordatorio".
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id])
  clientName    String? // copia del nombre al momento de la alerta, por si el cliente cambia de nombre o se borra
  reminderSentAt DateTime? // cuándo se hizo clic en "Enviar recordatorio" (null = todavía no se envió)
  read          Boolean     @default(false) // se marca leída al cerrar el modal o abrir la sección de notificaciones
  emailSentAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([distributorId, read])
  @@index([clientId, productId, createdAt])
}

// Cliente (empresa compradora)
model Client {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  rut              String? // RUT de la empresa, si tiene
  cedula           String? // Cédula de identidad, para clientes (almacenes chicos, etc.) sin RUT
  name             String?
  email            String?
  phone            String?
  address          String? // dirección del comercio/almacén, para reparto
  accessCode       String? // código individual para acceder al catálogo, enviado por email
  accessCodeSentAt DateTime?
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())

  orders            Order[]
  clientPrices      ClientPrice[]
  pushSubscriptions PushSubscription[]
  stockAlerts       StockAlert[]
  stockWaitlist     StockWaitlist[]

  // Al menos uno de rut/cedula debe estar presente (ver migración: CHECK constraint).
  // Nulos no chocan entre sí en Postgres, por lo que ambos unique constraints conviven.
  @@unique([distributorId, rut])
  @@unique([distributorId, cedula])
}

// Suscripción a notificaciones push del navegador (Web Push API) de un
// cliente puntual, guardada cuando acepta el permiso de notificaciones en el
// catálogo. Un mismo cliente puede tener varias filas si entra desde el
// celular y la compu — cada "endpoint" es un dispositivo/navegador distinto.
// Se usa para el recordatorio diario de "no olvides hacer tu pedido"
// (ver reminderService.ts). Si el navegador invalida la suscripción (el
// cliente desinstaló la PWA, borró el permiso, etc.), Web Push devuelve
// 404/410 al enviar y esa fila se borra sola (ver lib/webPush.ts).
model PushSubscription {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  endpoint      String      @unique
  p256dh        String
  auth          String
  createdAt     DateTime    @default(now())

  @@index([clientId])
  @@index([distributorId])
}

// Descuento especial que un distribuidor le da a un cliente puntual para un
// producto puntual (ej: un cliente que compra mucho de un producto recibe un
// descuento). Si no hay fila acá, el cliente paga el precio de lista normal
// (Product.price). Se guarda como porcentaje (no precio fijo) para que si el
// precio de lista cambia, el descuento se siga aplicando sobre el precio
// nuevo. Se gestiona desde la ficha del cliente ("+ Agregar descuento") — así
// un mismo producto puede tener un % distinto para cada cliente, sin pisarse.
model ClientPrice {
  id              String      @id @default(cuid())
  distributorId   String
  distributor     Distributor @relation(fields: [distributorId], references: [id])
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  discountPercent Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([clientId, productId])
  @@index([distributorId, productId])
}

// Cliente que pidió que le avisen cuando vuelva el stock de un producto que
// está agotado ("🔔 Avisame cuando llegue" en el catálogo). Se cumple una
// sola vez: cuando la distribuidora repone stock (pasa de 0 a más de 0), se
// manda el push a todos los que están anotados para ese producto y se borra
// la lista entera de ese producto (ver backInStockNotificationService.ts).
// Si el producto se vuelve a agotar más adelante, el cliente puede anotarse
// de nuevo.
model StockWaitlist {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([clientId, productId])
  @@index([distributorId, productId])
}

// Registro de cada mail enviado (Message-ID + fecha), usado por el job de
// limpieza (ver emailCleanupService.ts) para borrar la copia de "Enviados"
// de la cuenta de Gmail una vez pasada una hora — así StockApp no conserva
// un historial de la correspondencia entre distribuidoras y clientes.
model SentEmail {
  id        String    @id @default(cuid())
  messageId String    @unique
  sentAt    DateTime  @default(now())
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([deletedAt, sentAt])
}

// Pedido
model Order {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  total         Float
  status        OrderStatus @default(PENDING)
  notes         String?
  // Cargados opcionalmente por la distribuidora al marcar el pedido como "En
  // Proceso" (ver updateOrderStatus) — se muestran al cliente en el
  // seguimiento de su pedido si están completos. estimatedDeliveryDate guarda
  // solo la fecha (sin hora); estimatedDeliveryTime es un texto libre tipo
  // "14:30" porque la hora es opcional e independiente de la fecha.
  estimatedDeliveryDate DateTime? @db.Date
  estimatedDeliveryTime String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]
}

// Item del pedido
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  subtotal  Float
  // Copia de Product.ivaType al momento de la compra — igual que unitPrice/
  // subtotal, no se lee en vivo del producto para que un cambio posterior de
  // tasa no altere pedidos/comprobantes ya generados.
  ivaType   IvaType @default(BASICA)
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

// Tasas de IVA de Uruguay relevantes para el catálogo de un distribuidor
// (no incluye la tasa 0%/exenta, que hoy no se contempla en el sistema).
enum IvaType {
  BASICA // 22%
  MINIMA // 10%
}

enum ContactRequestStatus {
  NEW
  CONTACTED
  DISCARDED
}

// Solicitud de contacto de un potencial cliente (distribuidora) que todavía
// no tiene cuenta. Se genera desde el botón "Contactate con nosotros" en la
// home pública (apps/web) y aparece en el panel de superadmin, sección
// "Solicitudes", para que el equipo comercial la gestione manualmente y dé
// de alta a la distribuidora si corresponde.
model ContactRequest {
  id        String               @id @default(cuid())
  name      String?
  email     String
  phone     String
  status    ContactRequestStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}
