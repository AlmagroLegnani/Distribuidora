generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Distribuidor (tenant)
model Distributor {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // hash bcrypt
  phone     String?
  logoUrl   String?
  slug      String   @unique // identificador único de URL ej: "distrib-norte"
  categories String[] @default([]) // rubros de la distribuidora (multi-select), ej: "Bebidas", "Limpieza e Higiene"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  clients      Client[]
  orders       Order[]
  settings     DistributorSettings?
  subscription Subscription?
  resetTokens  PasswordResetToken[]
  stockAlerts  StockAlert[]
  clientPrices ClientPrice[]
}

// Administrador de la plataforma (dueño del SaaS, no un distribuidor)
model PlatformAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // hash bcrypt
  name      String?
  createdAt DateTime @default(now())
}

// Plan comercial ofrecido a las distribuidoras
model Plan {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  price          Float    // precio mensual
  currency       String   @default("UYU")
  maxProducts    Int?     // null = ilimitado
  maxClients     Int?
  maxOrdersMonth Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDING_PAYMENT // recién creada, esperando primer pago
  TRIALING
  ACTIVE
  PAST_DUE // venció el período pero está en gracia
  SUSPENDED // se cortó el acceso por falta de pago
  CANCELLED
}

// Suscripción de una distribuidora a un plan
model Subscription {
  id               String             @id @default(cuid())
  distributorId    String             @unique
  distributor      Distributor        @relation(fields: [distributorId], references: [id])
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(PENDING_PAYMENT)
  currentPeriodEnd DateTime?
  trialEndsAt      DateTime?
  mpPreferenceId   String? // id de la preferencia/checkout de MercadoPago vigente
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments Payment[]
}

// Pago registrado (MercadoPago o manual)
model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  mpPaymentId    String?      @unique
  amount         Float
  currency       String       @default("UYU")
  status         String       // approved | pending | rejected | manual
  method         String       @default("mercadopago") // mercadopago | manual
  paidAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
}

// Token de recuperación de contraseña para distribuidores
model PasswordResetToken {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  token         String      @unique
  expiresAt     DateTime
  used          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

// Configuración del distribuidor
model DistributorSettings {
  id                String      @id @default(cuid())
  distributorId     String      @unique
  distributor       Distributor @relation(fields: [distributorId], references: [id])
  notificationEmail String?
  whatsappNumber    String?
  sendClientEmail   Boolean     @default(true)
  sendWhatsapp      Boolean     @default(false)
}

// Producto
model Product {
  id              String      @id @default(cuid())
  distributorId   String
  distributor     Distributor @relation(fields: [distributorId], references: [id])
  name            String
  code            String?
  brand           String?
  description     String?
  price           Float
  stock           Int
  category        String?
  imageUrl        String?
  active          Boolean     @default(true)
  // true mientras el stock sigue por debajo del umbral de aviso (ver stockAlertService.LOW_STOCK_THRESHOLD)
  // y ya se generó una alerta; se resetea a false cuando el stock vuelve a superar el umbral,
  // para poder avisar de nuevo si vuelve a caer más adelante.
  lowStockAlerted Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems   OrderItem[]
  stockAlerts  StockAlert[]
  clientPrices ClientPrice[]

  @@unique([distributorId, code])
}

// Notificación mostrada al distribuidor en su panel (sección "Notificaciones" +
// modal al ingresar). Nació como aviso de stock bajo (ver stockAlertService.ts)
// y se generalizó para poder avisar también vencimientos de pago (ver
// platformService.notifyPaymentDue) — de ahí que los campos de producto sean
// opcionales y sólo se completen cuando type = LOW_STOCK.
model StockAlert {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  type          String      @default("LOW_STOCK") // LOW_STOCK | PAYMENT_DUE
  message       String? // texto ya armado para tipos que no son de stock (ej: aviso de vencimiento)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  productName   String? // copia del nombre al momento de la alerta, por si el producto cambia de nombre o se borra
  stockAtAlert  Int?
  threshold     Int?
  read          Boolean     @default(false) // se marca leída al cerrar el modal o abrir la sección de notificaciones
  emailSentAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([distributorId, read])
}

// Cliente (empresa compradora)
model Client {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  rut              String? // RUT de la empresa, si tiene
  cedula           String? // Cédula de identidad, para clientes (almacenes chicos, etc.) sin RUT
  name             String?
  email            String?
  phone            String?
  accessCode       String? // código individual para acceder al catálogo, enviado por email
  accessCodeSentAt DateTime?
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())

  orders       Order[]
  clientPrices ClientPrice[]

  // Al menos uno de rut/cedula debe estar presente (ver migración: CHECK constraint).
  // Nulos no chocan entre sí en Postgres, por lo que ambos unique constraints conviven.
  @@unique([distributorId, rut])
  @@unique([distributorId, cedula])
}

// Precio especial que un distribuidor le da a un cliente puntual para un
// producto puntual (ej: un cliente que compra mucho de un producto recibe un
// descuento). Si no hay fila acá, el cliente paga el precio de lista normal
// (Product.price). Se gestiona desde el botón "Precio especial" en Productos,
// o desde la ficha del cliente.
model ClientPrice {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  price         Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([clientId, productId])
  @@index([distributorId, productId])
}

// Registro de cada mail enviado (Message-ID + fecha), usado por el job de
// limpieza (ver emailCleanupService.ts) para borrar la copia de "Enviados"
// de la cuenta de Gmail una vez pasada una hora — así StockApp no conserva
// un historial de la correspondencia entre distribuidoras y clientes.
model SentEmail {
  id        String    @id @default(cuid())
  messageId String    @unique
  sentAt    DateTime  @default(now())
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([deletedAt, sentAt])
}

// Pedido
model Order {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  total         Float
  status        OrderStatus @default(PENDING)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]
}

// Item del pedido
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  subtotal  Float
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}
