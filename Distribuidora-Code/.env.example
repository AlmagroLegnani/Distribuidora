# Base de datos
DATABASE_URL="postgresql://stockapp:stockapp@localhost:5432/stockapp"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="noreply@tudominio.com"

# WhatsApp (Twilio - opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# MercadoPago (cobro de suscripciones a distribuidoras)
# Obtén tu access token en https://www.mercadopago.cl/developers/panel/app
# Sin esto, el signup público sigue funcionando (prueba gratis) pero no se
# genera el link de pago hasta que lo configures.
MERCADOPAGO_ACCESS_TOKEN=

# App
# URL interna del backend (packages/api), usada solo del lado del servidor
# por apps/web (next.config.js > rewrites, y por los módulos lib/*/api.ts
# cuando corren en un Server Component) para reenviar /api/* y /health.
# Nunca se expone al navegador.
INTERNAL_API_URL="http://localhost:3001"
PORT=3001
NODE_ENV=development

# URL pública de la app unificada (apps/web) — usada en los back_urls de
# MercadoPago y en el link de "recuperar contraseña"
PLATFORM_URL="http://localhost:3000"
# URL pública de la API (packages/api) — usada como notification_url del webhook de MercadoPago.
# En producción debe ser una URL accesible desde internet (no localhost).
API_PUBLIC_URL="http://localhost:3001"

# CORS origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000"
